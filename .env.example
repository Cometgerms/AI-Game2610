# Server-side AI integration. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
MODEL_NAME=gpt-6.1-sol
AI_SESSION_BUDGET_USD=1.00
# The local adapter caps this at $10. Failed/unknown calls retain a $0.30 reservation.
AI_PROJECT_BUDGET_USD=10.00
SERVER_PORT=8080

# Email OTP: use a dedicated Supabase project. Never put a secret/service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional private file path; default .data/rooms.json. Keep outside public/ and Git.
GAME_DATA_PATH=
